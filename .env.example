# Awaaz se Kaam — configuration template
# Copy to backend/.env and fill in real values. NEVER commit the real file.

# LLM provider for /api/tasks/* endpoints: SARVAM | MOCK
AI_PROVIDER=SARVAM

# Sarvam AI (https://dashboard.sarvam.ai/) — required when AI_PROVIDER=SARVAM
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Port the Android app connects to (via `adb reverse tcp:8081 tcp:8081`)
PORT=8081

# ---- Legacy OpenRouter provider (/api/extract-task, /api/verify-task) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
